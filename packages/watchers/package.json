{
  "name": "@agora/telescope-watchers",
  "version": "0.1.0",
  "description": "Per-technology AdonisJS watchers for @agora/telescope — records every Lucid SQL query (db:query, with bindings + duration) plus mail-sent and cache events as queryable telescope entries.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-telescope.git",
    "directory": "packages/watchers"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./telescope_watchers_provider": {
      "types": "./dist/providers/telescope_watchers_provider.d.ts",
      "import": "./dist/providers/telescope_watchers_provider.js",
      "default": "./dist/providers/telescope_watchers_provider.js"
    },
    "./configure": {
      "types": "./dist/configure.d.ts",
      "import": "./dist/configure.js",
      "default": "./dist/configure.js"
    }
  },
  "files": ["dist/", "stubs/", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run copy:stubs",
    "copy:stubs": "mkdir -p dist/stubs/config && cp stubs/config/telescope_watchers.stub dist/stubs/config/telescope_watchers.stub",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agora/telescope": "workspace:^"
  },
  "peerDependencies": {
    "@adonisjs/core": "^6.12.0",
    "@adonisjs/lucid": "^21.0.0",
    "@adonisjs/mail": "^9.0.0",
    "@adonisjs/cache": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/lucid": { "optional": true },
    "@adonisjs/mail": { "optional": true },
    "@adonisjs/cache": { "optional": true }
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.0",
    "@adonisjs/core": "^6.17.0",
    "@adonisjs/lucid": "^21.6.1",
    "@agora/telescope": "workspace:*",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "lucid",
    "telescope",
    "observability",
    "watcher",
    "query",
    "mail",
    "cache",
    "agora"
  ]
}
