{
  "name": "@agora/telescope-alerts",
  "version": "0.1.0",
  "description": "Alerting for @agora/telescope — detects new exception families (and re-occurrences after resolve) from telescope entries and dispatches rich alerts to Slack, generic webhook, or console channels.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-telescope.git",
    "directory": "packages/alerts"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./telescope_alerts_provider": {
      "types": "./dist/providers/telescope_alerts_provider.d.ts",
      "import": "./dist/providers/telescope_alerts_provider.js",
      "default": "./dist/providers/telescope_alerts_provider.js"
    },
    "./configure": {
      "types": "./dist/configure.d.ts",
      "import": "./dist/configure.js",
      "default": "./dist/configure.js"
    }
  },
  "files": ["dist/", "stubs/", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run copy:stubs",
    "copy:stubs": "mkdir -p dist/stubs/config && cp stubs/config/telescope_alerts.stub dist/stubs/config/telescope_alerts.stub",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agora/telescope": "workspace:^"
  },
  "peerDependencies": {
    "@adonisjs/core": "^6.12.0"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.0",
    "@adonisjs/core": "^6.17.0",
    "@agora/telescope": "workspace:*",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "telescope",
    "observability",
    "alerts",
    "alerting",
    "slack",
    "webhook",
    "exceptions",
    "agora"
  ]
}
