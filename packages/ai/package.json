{
  "name": "@agora/telescope-ai",
  "version": "0.1.0",
  "description": "AI-assisted diagnosis for @agora/telescope — turns an exception telescope entry (plus related trace entries) into a structured root-cause diagnosis via the Anthropic Claude API, cached by exception family hash.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-telescope.git",
    "directory": "packages/ai"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./telescope_ai_provider": {
      "types": "./dist/providers/telescope_ai_provider.d.ts",
      "import": "./dist/providers/telescope_ai_provider.js",
      "default": "./dist/providers/telescope_ai_provider.js"
    },
    "./configure": {
      "types": "./dist/configure.d.ts",
      "import": "./dist/configure.js",
      "default": "./dist/configure.js"
    }
  },
  "files": ["dist/", "stubs/", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run copy:stubs",
    "copy:stubs": "mkdir -p dist/stubs/config && cp stubs/config/telescope_ai.stub dist/stubs/config/telescope_ai.stub",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agora/telescope": "workspace:^"
  },
  "peerDependencies": {
    "@adonisjs/core": "^6.12.0",
    "@anthropic-ai/sdk": "^0.32.0"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.0",
    "@adonisjs/core": "^6.17.0",
    "@agora/telescope": "workspace:*",
    "@anthropic-ai/sdk": "^0.32.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "telescope",
    "observability",
    "ai",
    "anthropic",
    "claude",
    "diagnosis",
    "exceptions",
    "agora"
  ]
}
