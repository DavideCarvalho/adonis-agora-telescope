          'CREATE INDEX CONCURRENTLY IF NOT EXISTS ?? ON ?? (type, created_at) INCLUDE (family_hash, trace_id, duration_ms)',
          [this.tableName + '_type_created_at_cover_idx', table]
        )
        await db.rawQuery(
          'ALTER TABLE ?? SET (autovacuum_vacuum_scale_factor = 0.02, autovacuum_vacuum_insert_scale_factor = 0.02)',
          [table]
        )
      })
      return
    }
    this.builder().alterTable(this.tableName, (t) => {
      t.index(['duration_ms'], this.tableName + '_duration_ms_idx')
      t.index(['created_at', 'type'], this.tableName + '_created_at_type_idx')
    })
  }

