import { defineConfig } from '@adonis-agora/telescope/ui'

/**
 * Configuration for '@adonis-agora/telescope/ui'. By default the dashboard mounts at
 * /telescope and is reachable automatically outside production. In production it is
 * denied unless you set a token / basic credential below, or supply your own
 * authorize hook delegating to your app's auth.
 */
export default defineConfig({
  /**
   * Master switch. Set to false to register no routes at all.
   */
  // enabled: true,

  /**
   * URL prefix. The dashboard is served here; the JSON API lives at <path>/api/*.
   */
  // path: '/telescope',

  /**
   * Access-decision hook. Return true to allow the request, false to reject it
   * (the guard answers 401 when no credential was presented, 403 when one was and
   * was rejected). Delegate to your own app auth here, e.g.:
   */
  // authorize: (ctx) => ctx.auth?.user?.isAdmin === true,

  /**
   * Built-in credentials for the default policy (ignored when authorize is set).
   * Gate a production dashboard without writing a hook:
   *  - token: allow 'Authorization: Bearer <token>' or '?token=<token>'
   *  - basic: allow HTTP Basic auth
   */
  // credentials: {
  //   token: env.get('TELESCOPE_UI_TOKEN'),
  //   basic: { username: 'admin', password: env.get('TELESCOPE_UI_PASSWORD') },
  // },

  /**
   * Built-in login screen. When present, the provider mounts a server-rendered
   * login page plus its submit and logout routes, and stamps a session guard on the
   * dashboard: an unauthenticated page navigation is redirected to the login page
   * and an unauthenticated API request gets a 401. The signed session cookie is
   * minted only by your own login hook.
   *
   * This is ADDITIVE and composes WITH authorize (both must pass). Omit it entirely
   * to keep the dashboard's default behavior. A missing secret or login hook fails
   * closed at boot.
   */
  // dashboardAuth: {
  //   secret: env.get('TELESCOPE_DASHBOARD_SECRET'),
  //   ttl: '8h',
  //   login: async (username, password) => {
  //     const user = await User.verifyCredentials(username, password)
  //     return user.isAdmin ? { id: String(user.id), name: user.fullName } : null
  //   },
  // },

  /**
   * Request REPLAY: re-issue a captured request from the dashboard against the
   * LOCAL server. DISABLED BY DEFAULT because it re-runs a real request that may
   * MUTATE state (a captured POST/DELETE runs again). It only ever targets
   * 127.0.0.1:<port> (same-origin, never an arbitrary URL) and strips
   * cookie/authorization/host headers. Enable it knowingly:
   */
  // replay: {
  //   enabled: true,
  //   // port: 3333,      // defaults to the PORT env var, then 3333
  //   // timeoutMs: 30_000,
  // },

  /**
   * The dashboard's 'arm a CPU profile' trigger. DISABLED BY DEFAULT, like replay —
   * arming a capture runs a V8 sampling profiler over the next requests, which costs
   * real CPU. READING captured profiles is unaffected; only the arm action is gated.
   * Requires '@adonis-agora/telescope/cpu_profiling' to be installed and enabled.
   */
  // cpuProfiling: {
  //   armEnabled: true,
  // },

  /**
   * The queue console's MUTATING actions (retry / enqueue). DISABLED BY DEFAULT,
   * like replay — they act on real jobs. Reading the queue console is unaffected.
   * Requires the 'queue-manager' watcher in config/telescope_watchers.ts.
   */
  // queueActions: {
  //   enabled: true,
  // },
})
