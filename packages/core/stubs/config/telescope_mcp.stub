/** Uncomment alongside the authorizeByToken example below. */
// import env from '#start/env'
// import { authorizeByToken } from '@adonis-agora/telescope/mcp'
import { defineConfig } from '@adonis-agora/telescope/mcp'

/**
 * Configuration for '@adonis-agora/telescope/mcp'. Exposes the captured telemetry to
 * a coding agent (Claude Code, Cursor, …) over the Model Context Protocol as a
 * JSON-RPC endpoint at 'POST /telescope/mcp'.
 *
 * Without authorize it is open outside production and answers 403 to every request
 * in production, so set authorize before you deploy. A denial is JSON:
 * 403 { error: 'forbidden' } or 401 { error: 'unauthenticated' }.
 */
export default defineConfig({
  /**
   * Master switch. Set to false to register no routes at all.
   */
  // enabled: true,

  /**
   * URL the JSON-RPC endpoint mounts at.
   */
  // path: '/telescope/mcp',

  /**
   * Who may call the endpoint: the same authorize contract as the console. MCP
   * clients send 'Authorization: Bearer <token>', so import authorizeByToken from
   * '@adonis-agora/telescope/mcp' and use:
   */
  // authorize: authorizeByToken({ token: env.get('TELESCOPE_MCP_TOKEN') }),

  /**
   * Which tools to expose. Omit for all six ('list_entries', 'get_entry',
   * 'get_trace', 'get_waterfall', 'get_health', 'diagnose_exception'). Restrict to
   * a read-only surface, e.g.:
   */
  // tools: ['list_entries', 'get_entry', 'get_trace', 'get_waterfall', 'get_health'],
})
