{
  "name": "@agora/telescope-ui",
  "version": "0.1.0",
  "description": "A self-contained web dashboard + JSON API for @agora/telescope — mounts HTTP routes that serve the headless TelescopeService over JSON and a single inline-HTML dashboard, behind a configurable auth guard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-telescope.git",
    "directory": "packages/ui"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./telescope_ui_provider": {
      "types": "./dist/providers/telescope_ui_provider.d.ts",
      "import": "./dist/providers/telescope_ui_provider.js",
      "default": "./dist/providers/telescope_ui_provider.js"
    },
    "./configure": {
      "types": "./dist/configure.d.ts",
      "import": "./dist/configure.js",
      "default": "./dist/configure.js"
    }
  },
  "files": ["dist/", "stubs/", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run copy:stubs && pnpm run copy:assets",
    "copy:stubs": "mkdir -p dist/stubs/config && cp stubs/config/telescope_ui.stub dist/stubs/config/telescope_ui.stub",
    "copy:assets": "mkdir -p dist/src && cp src/dashboard.html dist/src/dashboard.html",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agora/telescope": "workspace:^"
  },
  "peerDependencies": {
    "@adonisjs/core": "^6.12.0"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.0",
    "@adonisjs/core": "^6.17.0",
    "@agora/telescope": "workspace:*",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "telescope",
    "observability",
    "dashboard",
    "ui",
    "json-api",
    "auth",
    "agora"
  ]
}
