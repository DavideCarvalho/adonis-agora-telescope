{
  "name": "@adonis-agora/telescope-ui",
  "version": "0.1.2",
  "description": "Observability dashboard for @adonis-agora/telescope — a dependency-light React SPA (entries + live tail, entry detail, traces & waterfall, exception groups, Pulse health) served by a thin AdonisJS provider behind the same auth guard as the JSON API. Part of the Agora ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-telescope.git",
    "directory": "packages/ui"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/providers/telescope_ui_dashboard_provider.js",
  "types": "./dist/providers/telescope_ui_dashboard_provider.d.ts",
  "exports": {
    ".": {
      "types": "./dist/providers/telescope_ui_dashboard_provider.d.ts",
      "import": "./dist/providers/telescope_ui_dashboard_provider.js",
      "default": "./dist/providers/telescope_ui_dashboard_provider.js"
    },
    "./telescope_ui_dashboard_provider": {
      "types": "./dist/providers/telescope_ui_dashboard_provider.d.ts",
      "import": "./dist/providers/telescope_ui_dashboard_provider.js",
      "default": "./dist/providers/telescope_ui_dashboard_provider.js"
    },
    "./client": {
      "types": "./dist/src/client/index.d.ts",
      "import": "./dist/src/client/index.js",
      "default": "./dist/src/client/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.spa.json --noEmit"
  },
  "peerDependencies": {
    "@adonis-agora/telescope": "^0.5.0",
    "@adonisjs/core": "^7.3.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adonis-agora/telescope": "workspace:*",
    "@adonisjs/core": "^7.3.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "telescope",
    "observability",
    "dashboard",
    "spa",
    "react",
    "tracing",
    "pulse",
    "agora"
  ]
}
