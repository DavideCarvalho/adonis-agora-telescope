{
  "name": "@adonis-agora/telescope-ui",
  "version": "1.0.0",
  "description": "Observability dashboard for @adonis-agora/telescope — a dependency-light React SPA (entries + live tail, entry detail, traces & waterfall, exception groups, Pulse health) served by a thin AdonisJS provider behind the same auth guard as the JSON API. Part of the Agora ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-agora-telescope.git",
    "directory": "packages/ui"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/providers/telescope_ui_dashboard_provider.js",
  "types": "./dist/providers/telescope_ui_dashboard_provider.d.ts",
  "exports": {
    ".": {
      "types": "./dist/providers/telescope_ui_dashboard_provider.d.ts",
      "import": "./dist/providers/telescope_ui_dashboard_provider.js",
      "default": "./dist/providers/telescope_ui_dashboard_provider.js"
    },
    "./telescope_ui_dashboard_provider": {
      "types": "./dist/providers/telescope_ui_dashboard_provider.d.ts",
      "import": "./dist/providers/telescope_ui_dashboard_provider.js",
      "default": "./dist/providers/telescope_ui_dashboard_provider.js"
    },
    "./client": {
      "types": "./dist/src/client/index.d.ts",
      "import": "./dist/src/client/index.js",
      "default": "./dist/src/client/index.js"
    }
  },
  "files": ["dist/", "README.md", "CHANGELOG.md"],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "prepack": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.spa.json --noEmit && tsc -p tsconfig.tests.json"
  },
  "peerDependencies": {
    "@adonis-agora/telescope": "^0.8.0",
    "@adonisjs/core": "^7.3.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@adonis-agora/telescope": "workspace:*",
    "@adonisjs/core": "7.4.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.4",
    "jsdom": "25.0.1",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": "v26.7.0"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "telescope",
    "observability",
    "dashboard",
    "spa",
    "react",
    "tracing",
    "pulse",
    "agora"
  ]
}
