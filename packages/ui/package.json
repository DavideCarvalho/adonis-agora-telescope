{
  "name": "@adonis-agora/telescope-ui",
  "version": "1.1.5",
  "description": "Observability dashboard for @adonis-agora/telescope — a React SPA (overview, entries + live tail, entry detail, traces & waterfall, exception groups, Pulse health, CPU profiles, live queues and schedules, extension pages, client-side exports) built with Tailwind CSS and Base UI, served by a thin AdonisJS provider behind the same auth guard as the JSON API. Ships a dependency-free fetch client on the /client subpath. Part of the Agora ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-agora-telescope.git",
    "directory": "packages/ui"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/providers/telescope_ui_dashboard_provider.js",
  "types": "./dist/providers/telescope_ui_dashboard_provider.d.ts",
  "exports": {
    ".": {
      "types": "./dist/providers/telescope_ui_dashboard_provider.d.ts",
      "import": "./dist/providers/telescope_ui_dashboard_provider.js",
      "default": "./dist/providers/telescope_ui_dashboard_provider.js"
    },
    "./telescope_ui_dashboard_provider": {
      "types": "./dist/providers/telescope_ui_dashboard_provider.d.ts",
      "import": "./dist/providers/telescope_ui_dashboard_provider.js",
      "default": "./dist/providers/telescope_ui_dashboard_provider.js"
    },
    "./client": {
      "types": "./dist/src/client/index.d.ts",
      "import": "./dist/src/client/index.js",
      "default": "./dist/src/client/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "skills"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "prepack": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.spa.json --noEmit && tsc -p tsconfig.tests.json"
  },
  "peerDependencies": {
    "@adonis-agora/telescope": ">=0.11.0 <1.0.0",
    "@adonisjs/core": "^7.3.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@adonis-agora/telescope": "workspace:*",
    "@adonisjs/core": "7.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/intent": "^0.3.7",
    "@tanstack/react-table": "^9.2.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "telescope",
    "observability",
    "dashboard",
    "spa",
    "react",
    "tracing",
    "pulse",
    "agora",
    "tanstack-intent"
  ]
}
